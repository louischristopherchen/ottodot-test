# Copy to .env (or run `npm run setup`, which fills the secrets with random values).
# Every app reads this root file first, then its own apps/<app>/.env if present.

# --- API (apps/api) ---
NODE_ENV=development
PORT=4001
BIND_HOST=127.0.0.1
# Project-local Postgres from `npm run db:start`; point at any Postgres 14+.
DATABASE_URL=postgres://postgres@127.0.0.1:55432/trial_booking
# At least 32 random characters. Changing it signs everyone out.
JWT_SECRET=change-me
JWT_ACCESS_TTL=30m
REFRESH_TTL_DAYS=7
# Browser origins allowed to call the API, comma separated.
CORS_ORIGIN=http://localhost:4000
# true behind HTTPS; defaults to true outside development and test.
# COOKIE_SECURE=true
TRUST_PROXY=1
PAYMENT_PROVIDER_URL=http://127.0.0.1:4002
# Must equal SANDBOX_API_KEY.
PAYMENT_PROVIDER_API_KEY=change-me
PAYMENT_PROVIDER_TIMEOUT_MS=20000
LOG_LEVEL=info
BCRYPT_COST=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
PAYMENT_RATE_LIMIT_MAX=30
UNPAID_BOOKING_TTL_MINUTES=30
WORKER_INTERVAL_MS=10000
PAYMENT_JOB_MAX_ATTEMPTS=5
RECONCILE_AFTER_SECONDS=120

# --- Payments sandbox (apps/payments-sandbox) ---
SANDBOX_PORT=4002
SANDBOX_BIND_HOST=127.0.0.1
SANDBOX_API_KEY=change-me
SANDBOX_LATENCY_MS=800
SANDBOX_SLOW_LATENCY_MS=10000

# --- Web (apps/web, read at build time) ---
WEB_PORT=4000
API_URL=http://127.0.0.1:4001
SHOW_DEMO_ACCOUNTS=true
