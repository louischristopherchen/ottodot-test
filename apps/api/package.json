{
	"name": "@trial-booking/api",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"dev:worker": "tsx watch src/worker.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/index.js",
		"start:worker": "node dist/worker.js",
		"typecheck": "tsc --noEmit",
		"test:unit": "node --import tsx --import ./src/__tests__/support/test-env.ts --test \"src/__tests__/unit/*.test.ts\"",
		"test:integration": "npm run migrate:test && node --import tsx --import ./src/__tests__/support/test-env.ts --test --test-concurrency=1 \"src/__tests__/integration/*.test.ts\"",
		"migrate": "sequelize-cli db:migrate",
		"migrate:undo": "sequelize-cli db:migrate:undo",
		"migrate:test": "NODE_ENV=test sequelize-cli db:migrate",
		"migrate:create": "sh -c 'sequelize-cli migration:generate --name \"$1\" && for f in migrations/*.js; do [ ! -e \"${f%.js}.cjs\" ] && mv \"$f\" \"${f%.js}.cjs\"; done' --",
		"seed": "tsx src/scripts/seed.ts",
		"db:reset": "tsx src/scripts/seed.ts --reset",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@trial-booking/shared": "*",
		"bcryptjs": "^2.4.3",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^16.6.1",
		"express": "^4.22.3",
		"express-rate-limit": "^8.7.0",
		"helmet": "^8.3.0",
		"jsonwebtoken": "^9.0.3",
		"pg": "^8.23.0",
		"pg-hstore": "^2.3.4",
		"sequelize": "^6.37.8",
		"sequelize-cli": "^6.6.5",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/bcryptjs": "^2.4.6",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^4.17.25",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/pg": "^8.23.1",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3"
	}
}
