{
	"name": "@trial-booking/payments-sandbox",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit",
		"test:unit": "node --import tsx --test \"src/__tests__/*.test.ts\"",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@trial-booking/shared": "*",
		"express": "^4.22.3",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/express": "^4.17.25",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3"
	}
}
